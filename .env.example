# =============================================================================
# Integration Service — environment
# =============================================================================
# Copy to .env for local dev; provision from your secrets manager in prod.

NODE_ENV=development
PORT=4001

# Postgres — the docker-compose stack ships a `postgres` service.
DATABASE_URL=postgres://codepulse:codepulse@postgres:5432/codepulse

# ---- Crypto ----------------------------------------------------------------
# 32 bytes, base64.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY_BASE64=REPLACE_ME_WITH_32_BYTES_BASE64

# HMAC key for signed OAuth state.  >= 32 chars random.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
OAUTH_STATE_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Shared secret with the main backend.  >= 16 chars.
INTERNAL_API_KEY=REPLACE_ME_WITH_A_SHARED_SECRET

# ---- Public reachability ---------------------------------------------------
# For local dev, use ngrok / cloudflared / localtunnel to expose port 4001
# and paste the https URL here.  GitHub/GitLab hit this URL for webhooks.
PUBLIC_BASE_URL=https://your-tunnel-hostname.example

# ---- GitHub OAuth App ------------------------------------------------------
# Create at https://github.com/settings/developers → "New OAuth App".
# Homepage URL = your frontend URL (e.g. http://localhost:3000)
# Authorization callback URL = <MAIN_BACKEND_PUBLIC_URL>/integrations/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- GitLab OAuth Application ---------------------------------------------
# Create at https://gitlab.com/-/user_settings/applications → "Add new application".
# Redirect URI = <MAIN_BACKEND_PUBLIC_URL>/integrations/oauth/gitlab/callback
# Confidential = YES.  Scopes = api, read_api, read_repository, read_user.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# GITLAB_HOST_URL=https://gitlab.your-company.com   # only for self-hosted
