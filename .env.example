PORT=5001

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=integration_service_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# -----------------------------------------------------------------------
# GitHub OAuth
# Register at: https://github.com/settings/developers
# Redirect URI: http://localhost:5001/api/integrations/github/oauth/callback
# Scopes: repo
# -----------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5001/api/integrations/github/oauth/callback

# -----------------------------------------------------------------------
# GitLab OAuth
# Register at: https://gitlab.com/-/profile/applications
# Redirect URI: http://localhost:5001/api/integrations/gitlab/oauth/callback
# Scopes: read_repository, read_user
# -----------------------------------------------------------------------
GITLAB_CLIENT_ID=your_gitlab_client_id
GITLAB_CLIENT_SECRET=your_gitlab_client_secret
GITLAB_CALLBACK_URL=http://localhost:5001/api/integrations/gitlab/oauth/callback

# -----------------------------------------------------------------------
# Token encryption — AES-256-GCM
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------
ENCRYPTION_KEY=YOUR_32_BYTE_HEX_KEY

# -----------------------------------------------------------------------
# Frontend
# FRONTEND_ORIGIN is used for CORS; the SUCCESS/ERROR URLs are where the
# OAuth callback redirects the browser after completing/failing the flow.
# -----------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_SUCCESS_URL=http://localhost:3000/authorization-success
FRONTEND_ERROR_URL=http://localhost:3000/repository-details

# -----------------------------------------------------------------------
# Webhook auto-registration
# A hook is created automatically on the connected repository right after
# OAuth completes (see IntegrationService.handleOAuthCallback), pointed at
# WEBHOOK_LISTENER_URL. Must be reachable from GitHub/GitLab's servers, not
# just from this machine. Each hook gets its own random secret, stored
# encrypted on the integration row, so there's no webhook secret to set here.
# -----------------------------------------------------------------------
WEBHOOK_LISTENER_URL=http://localhost:5002

# -----------------------------------------------------------------------
# Service-to-service auth
# webhook-listener sends this as a bearer token to
# GET /internal/webhook-secrets. It must be the same value in both services.
# If it's unset, the internal endpoint returns 503.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------
INTERNAL_SERVICE_TOKEN=YOUR_INTERNAL_SERVICE_TOKEN
